# This file contains the fastlane.tools configuration
# for the Apple app.
# You can find the documentation at https://docs.fastlane.tools

default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    setup_ci

    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_CONNECT_API_KEY_KEY_FILEPATH"],
    )

    sync_code_signing(
      type: "appstore",
      readonly: is_ci
    )

    # MARKETING_VERSION lives in Logseq.xcconfig (there is no static
    # CFBundleShortVersionString in Info.plist), so read the resolved build
    # setting instead of get_version_number's plist lookup.
    settings = sh(
      "xcodebuild -project Logseq.xcodeproj -scheme 'Logseq App' " \
      "-configuration Release -showBuildSettings | " \
      "grep ' MARKETING_VERSION' | awk '{print $NF}'",
      log: false
    ).strip
    version_number = settings.empty? ? "0.0.1" : settings

    latest_build_number = latest_testflight_build_number(
      version: version_number,
      initial_build_number: 1,
    )
    build_number = latest_build_number + 1

    # The OCaml core objects are linked through the SwiftPM manifest's
    # LOGSEQ_NATIVE_LINK_INPUTS env lookup; the workflow builds them first.
    link_inputs_file = File.expand_path("../../../../_build/ios-core/device/native-link-inputs.txt", __FILE__)
    ENV["LOGSEQ_NATIVE_LINK_INPUTS"] = File.read(link_inputs_file).strip

    # CURRENT_PROJECT_VERSION is overridden on the command line so every
    # upload lands a unique build number without editing the xcconfig.
    build_app(
      project: "Logseq.xcodeproj",
      destination: "generic/platform=iOS",
      scheme: "Logseq App",
      configuration: "Release",
      xcargs: "-allowProvisioningUpdates -skipPackagePluginValidation -skipMacroValidation CURRENT_PROJECT_VERSION=#{build_number}"
    )

    upload_to_testflight(
      skip_submission: true,
      skip_waiting_for_build_processing: true,
    )

    slack(message: "Logseq iOS build (#{build_number}) successfully uploaded to TestFlight 🎉!")
  end
end
