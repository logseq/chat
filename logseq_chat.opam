opam-version: "2.0"
synopsis: "Logseq chat mobile core backed by DataScript OCaml"
maintainer: "Logseq <hello@logseq.com>"
authors: "Logseq"
license: "MIT"
depends: [
  "ocaml" {>= "5.1.0"}
  "dune" {>= "3.17"}
  "datascript_ocaml"
  "datascript-ocaml-native"
  "melange-edn-native"
  "melange-transit-native"
  "lui"
  "ocaml-signal"
  "ctypes"
  "ctypes-foreign"
  "alcotest" {with-test}
  "drive" {with-test}
  "mldoc"
  "ocaml-fsrs"
  "yojson"
  "sqlite3"
]
pin-depends: [
  ["datascript_ocaml.dev" "git+https://github.com/logseq/datascript-ocaml.git#e439cbac48b28800820984ea3e285cf26a4f92b5"]
  ["datascript-ocaml-native.dev" "git+https://github.com/logseq/datascript-ocaml.git#e439cbac48b28800820984ea3e285cf26a4f92b5"]
  ["persistent_sorted_set_ocaml.dev" "git+https://github.com/logseq/persistent-sorted-set-ocaml.git#4016dae1cdf4304207d8277ff9957656cdd8b177"]
  ["melange-edn-core.0.5.0" "git+https://github.com/logseq/melange-edn.git#main"]
  ["melange-edn-native.0.5.0" "git+https://github.com/logseq/melange-edn.git#main"]
  ["melange-edn-melange.0.5.0" "git+https://github.com/logseq/melange-edn.git#main"]
  ["melange-transit-core.0.1.2" "git+https://github.com/logseq/melange-transit.git#main"]
  ["melange-transit-native.0.1.2" "git+https://github.com/logseq/melange-transit.git#main"]
  ["melange-transit-melange.0.1.2" "git+https://github.com/logseq/melange-transit.git#main"]
  ["lui.0.1.0" "git+ssh://git@github.com/logseq/lui.git#d2b3b07"]
  ["drive.dev" "git+https://github.com/logseq/drive.git#7f407b07f18e68596cb0dcb3ba1781cb0572a2bb"]
  ["ocaml-signal.0.1.0" "git+https://github.com/logseq/ocaml-signal.git#b9cb81fc910519fc579a90960267acb851483bca"]
  ["mldoc.dev" "git+https://github.com/logseq/mldoc.git#553dea6ed8694352527a189747f787365469c9cb"]
  ["angstrom.dev" "git+https://github.com/logseq/angstrom.git#3be9b966dc2bc9ccf9948d17a7b0df1cb526de15"]
  ["xmlm.dev" "git+https://github.com/logseq/xmlm.git#eb469d536e98c98f2754c0ff8813c92b3a17fe9f"]
  ["ocaml-fsrs.0.1.0-alpha3" "git+https://github.com/logseq/ocaml-fsrs.git#472b8ff1b86e5afd2ac4bbeba5e2eecedd3948fc"]
]
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" name "-j" jobs "@install" "@runtest" {with-test}]
]
