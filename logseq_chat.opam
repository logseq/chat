opam-version: "2.0"
synopsis: "Logseq chat mobile core backed by DataScript OCaml"
maintainer: "Logseq <hello@logseq.com>"
authors: "Logseq"
license: "MIT"
depends: [
  "ocaml" {>= "5.1.0"}
  "dune" {>= "3.17"}
  "datascript_ocaml"
  "datascript-ocaml-native"
  "melange-edn-native"
  "melange-transit-native"
  "lg"
  "lg-test" {with-test}
  "lui"
  "signal-lg"
  "mldoc"
  "ocaml-fsrs"
  "yojson"
]
pin-depends: [
  ["datascript_ocaml.dev" "git+https://github.com/logseq/datascript-ocaml.git#817636ef1f10b94adb4d729766293145a3fb9b9c"]
  ["datascript-ocaml-native.dev" "git+https://github.com/logseq/datascript-ocaml.git#817636ef1f10b94adb4d729766293145a3fb9b9c"]
  ["persistent_sorted_set_ocaml.dev" "git+https://github.com/logseq/persistent-sorted-set-ocaml.git#9b4e736dfe429861efff7d5c388451a2ad6152f7"]
  ["melange-edn-core.0.5.0" "git+https://github.com/RCmerci/melange-edn.git#3cb79f278e972388a0a2b2ea1caec7a008a0b956"]
  ["melange-edn-native.0.5.0" "git+https://github.com/RCmerci/melange-edn.git#3cb79f278e972388a0a2b2ea1caec7a008a0b956"]
  ["melange-edn-melange.0.5.0" "git+https://github.com/RCmerci/melange-edn.git#3cb79f278e972388a0a2b2ea1caec7a008a0b956"]
  ["melange-transit-core.0.1.0" "git+https://github.com/tiensonqin/melange-transit.git#898bc1418e8e6405f53d659209d932cddc6e3070"]
  ["melange-transit-native.0.1.0" "git+https://github.com/tiensonqin/melange-transit.git#898bc1418e8e6405f53d659209d932cddc6e3070"]
  ["melange-transit-melange.0.1.0" "git+https://github.com/tiensonqin/melange-transit.git#898bc1418e8e6405f53d659209d932cddc6e3070"]
  ["lg.dev" "git+https://github.com/tiensonqin/lg.git#e69a52952a93bcc1fa77ccfdef74a21f0d35928f"]
  ["lui.0.1.0" "git+https://github.com/tiensonqin/lui.git#f3e523a7ac4b651676c89eb3ea6e65cc23a39a23"]
  ["signal-lg.0.1.0" "git+https://github.com/tiensonqin/signal-lg.git#ed2e6c68322316d64bf41644480a5f8901940a02"]
  ["mldoc.dev" "git+https://github.com/logseq/mldoc.git#d139b5bafb52ac88913b36183c30f565dc700e28"]
  ["ocaml-fsrs.0.1.0-alpha3" "git+https://github.com/chaosarium/ocaml-fsrs.git#65e243d822a5dc18d50300300a2aa629cdd1beaf"]
]
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" name "-j" jobs "@install" "@runtest" {with-test}]
]
