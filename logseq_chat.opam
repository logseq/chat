opam-version: "2.0"
synopsis: "Logseq chat mobile core backed by DataScript OCaml"
maintainer: "Logseq <hello@logseq.com>"
authors: "Logseq"
license: "MIT"
depends: [
  "ocaml" {>= "5.1.0"}
  "dune" {>= "3.17"}
  "datascript_ocaml"
  "datascript-ocaml-native"
  "melange-edn-native"
  "melange-transit-native"
  "yojson"
]
pin-depends: [
  ["datascript_ocaml.dev" "git+https://github.com/logseq/datascript-ocaml.git#main"]
  ["datascript-ocaml-native.dev" "git+https://github.com/logseq/datascript-ocaml.git#main"]
  ["persistent_sorted_set_ocaml.dev" "git+https://github.com/logseq/persistent-sorted-set-ocaml.git#main"]
]
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" name "-j" jobs "@install" "@runtest" {with-test}]
]
