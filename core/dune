(rule
 (target logseq_chat_lg_core_native.ml)
 (deps
  %{lib:signal-lg.states:signal_native.state}
  ../lg/logseq_chat/ref_text.lgi
  ../lg/logseq_chat/ref_text.cljc
  ../lg/logseq_chat/sync_state.lgi
  ../lg/logseq_chat/sync_state.cljc
  %{bin:lg})
 (action
  (run
   %{bin:lg}
   --target native
   --compile-files-from %{lib:signal-lg.states:signal_native.state}
   ../lg/logseq_chat/ref_text.lgi
   ../lg/logseq_chat/ref_text.cljc
   ../lg/logseq_chat/sync_state.lgi
   ../lg/logseq_chat/sync_state.cljc
   -o %{target})))

