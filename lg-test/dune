(rule
 (target logseq_chat_lui_test.ml)
 (deps
  %{lib:signal-lg.states:signal_native.state}
  %{lib:lg:stdlib/lg/literal.cljc}
  (source_tree ../lg/logseq_chat)
  (source_tree logseq_chat)
  (source_tree ../duniverse/lui/lg/lui)
  %{lib:lg-test.sources:test.cljc}
  %{lib:lg-test.sources:test_native.cljc}
  %{lib:lg-test.sources:run.cljc}
  %{lib:lg-test.runtime:lg_test_runtime.cmi}
  %{lib:lg-test.alcotest:lg_test_alcotest.cmi}
  %{lib:threads.posix:thread.cmi}
  (:include lg_native_cmi_deps.sexp)
  lg_native_include_path
  (source_tree ../lg/logseq_chat/core)
  %{bin:lg})
 (action
  (setenv
   LG_OCAML_INCLUDE_PATH_AUTHORITATIVE
   1
   (setenv
    LG_OCAML_INCLUDE_PATH
    "%{env:OPAM_SWITCH_PREFIX=}/lib/lg-test/runtime:%{env:OPAM_SWITCH_PREFIX=}/lib/lg-test/alcotest:%{ocaml-config:standard_library}/threads:%{read-lines:lg_native_include_path}"
    (setenv
     OCAMLPATH
     "%{env:OPAM_SWITCH_PREFIX=}/lib/lg-test/runtime:%{env:OPAM_SWITCH_PREFIX=}/lib/lg-test/alcotest:%{ocaml-config:standard_library}/threads:%{read-lines:lg_native_include_path}"
     (run
      %{bin:lg}
      --target native
      --compile-files-from %{lib:signal-lg.states:signal_native.state}
      %{lib:lg:stdlib/lg/literal.cljc}
      ../duniverse/lui/lg/lui
      ../duniverse/lui/lg/lui/backend/retained
      ../duniverse/lui/lg/lui/backend/apple
      ../duniverse/lui/lg/lui/backend/flutter
      ../lg/logseq_chat/core
      ../lg/logseq_chat/model.lgi
      ../lg/logseq_chat/model.cljc
      ../lg/logseq_chat/view.lgi
      ../lg/logseq_chat/view.cljc
      ../lg/logseq_chat/app.lgi
      ../lg/logseq_chat/app.cljc
      ../lg/logseq_chat/snapshot.cljc
      ../lg/logseq_chat/native_bridge.lgi
      ../lg/logseq_chat/native_bridge.cljc
      %{lib:lg-test.sources:test.cljc}
      %{lib:lg-test.sources:test_native.cljc}
      logseq_chat
      %{lib:lg-test.sources:run.cljc}
      -o %{target}))))))

(executable
