(lang dune 3.23)

(context
 (opam
  (name mobile_host)
  (switch 5.5.0)))

(context
 (default
  (name ios_simulator)
  (host mobile_host)))

(context
 (default
  (name ios_device)
  (host mobile_host)))

(context
 (default
  (name android_arm64)
  (host mobile_host)))

(context
 (default
  (name android_x86_64)
  (host mobile_host)))

(context
 (default
  (name macos_arm64)
  (host mobile_host)))
