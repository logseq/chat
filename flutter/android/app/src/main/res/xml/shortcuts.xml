<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="capture"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_capture"
        android:shortcutShortLabel="@string/shortcut_capture"
        android:shortcutLongLabel="@string/shortcut_capture_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.logseq.chat"
            android:targetClass="com.logseq.chat.MainActivity"
            android:data="logseqchat://capture" />
    </shortcut>
    <shortcut
        android:shortcutId="journal"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_journal"
        android:shortcutShortLabel="@string/shortcut_journal"
        android:shortcutLongLabel="@string/shortcut_journal_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.logseq.chat"
            android:targetClass="com.logseq.chat.MainActivity"
            android:data="logseqchat://journal" />
    </shortcut>
</shortcuts>
