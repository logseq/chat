(ns logseq-chat.model)

(type-variant sync-state
  (OfflineState)
  (SyncingState)
  (SyncedState)
  (FailedState :string))

(type-variant navigation-route
  (NodeRoute :string))

(type-record chat-model
  (selected-graph :option<string>)
  (sync-state :sync-state)
  (search-open :bool)
  (search-query :string)
  (app-navigation-path :vector<navigation-route>)
  (search-navigation-path :vector<navigation-route>))

(type-variant chat-action
  (SelectGraph :string)
  (BeginSync)
  (SyncSucceeded)
  (SyncFailed :string)
  (OpenSearch)
  (ChangeSearchQuery :string)
  (CloseSearch)
  (RequestAppNode :string)
  (ResolveAppNode :string :bool)
  (BackAppNavigation)
  (RequestSearchNode :string)
  (ResolveSearchNode :string :bool)
  (BackSearchNavigation))

(signature logseq-chat.model/initial :fn<chat-model>)
(signature logseq-chat.model/request-route
 :fn<vector<navigation-route>;navigation-route;vector<navigation-route>>)
(signature logseq-chat.model/resolve-route
 :fn<vector<navigation-route>;navigation-route;bool;vector<navigation-route>>)
(signature logseq-chat.model/pop-route
 :fn<vector<navigation-route>;vector<navigation-route>>)
(signature logseq-chat.model/update :fn<chat-model;chat-action;chat-model>)
