(ns logseq-chat.model)

(type-variant sync-state
  (OfflineState)
  (SyncingState)
  (SyncedState)
  (FailedState :string))

(type-variant navigation-route
  (NodeRoute :string))

(type-variant primary-destination
  (JournalsDestination)
  (FlashcardsDestination)
  (GraphsDestination))

(type-record sidebar-page
  (uuid :string)
  (title :string))

(type-record graph
  (id :string)
  (name :string)
  (is-encrypted :bool)
  (is-ready :bool))

(type-record task-status
  (uuid :string)
  (ident :option<string>)
  (title :string)
  (icon-type :option<string>)
  (icon-id :option<string>)
  (icon-color :option<string>))

(type-record settings-projection
  (appearance :string)
  (language :string)
  (spell-check :bool)
  (auto-correction :bool)
  (sidebar-tabs :vector<string>)
  (base-url :string)
  (version :string)
  (revision :string))

(type-record settings-language-choice
  (id :string)
  (title :string))

(type-record settings-community-link
  (id :string)
  (title :string)
  (url :string))

(type-record runtime-log-record
  (id :string)
  (level :string)
  (source :string)
  (timestamp :string)
  (message :string))

(type-record flashcard-answer-row
  (uuid :string)
  (index :int)
  (text :string))

(type-record flashcard
  (uuid :string)
  (question-hidden :string)
  (question-revealed :string)
  (answer-rows :vector<flashcard-answer-row>)
  (has-cloze :bool))

(type-record sidebar-projection
  (favorites :vector<sidebar-page>)
  (recent-pages :vector<sidebar-page>)
  (selected-page :option<sidebar-page>)
  (selected-page-is-tag :bool)
  (selected-page-is-property :bool)
  (related-rows :vector<outline-row>)
  (linked-reference-rows :vector<outline-row>))

(type-record node-projection
  (uuid :string)
  (page-uuid :string)
  (title :string)
  (is-tag :bool)
  (is-property :bool)
  (related-rows :vector<outline-row>)
  (linked-reference-rows :vector<outline-row>))

(type-record search-hit
  (uuid :string)
  (title :string)
  (breadcrumb :string)
  (is-page :bool))

(type-record outline-row
  (uuid :string)
  (title :string)
  (markup-json :string)
  (youtube-target-url :option<string>)
  (breadcrumb :string)
  (opens-as-page :bool)
  (depth :int)
  (has-children :bool)
  (is-collapsed :bool)
  (is-asset :bool)
  (asset-type :option<string>)
  (local-path :option<string>)
  (status :option<task-status>)
  (tags :vector<sidebar-page>)
  (sync-status :option<string>)
  (page-id :string)
  (journal-title :option<string>)
  (journal-day :option<int>))

(type-record journal-section-marker
  (block-id :string)
  (page-id :string)
  (title :string)
  (has-divider :bool))

(type-record outliner-editing
  (uuid :string)
  (title :string)
  (caret-utf16-offset :int))

(type-variant outliner-autocomplete-kind
  (NodeAutocomplete)
  (TagAutocomplete)
  (PropertyAutocomplete))

(type-record outliner-autocomplete
  (kind :outliner-autocomplete-kind)
  (query :string))

(type-record outliner-autocomplete-candidate
  (index :int)
  (label :string)
  (value :string))

(type-record outline-row-splice
  (start :option<int>)
  (after-block-id :option<string>)
  (before-block-id :option<string>)
  (delete-count :int)
  (rows :vector<outline-row>))

(type-record core-projection
  (graph-name :option<string>)
  (selected-graph-id :option<string>)
  (graphs :vector<graph>)
  (is-graph-encrypted :bool)
  (is-graph-unlocked :bool)
  (sidebar :sidebar-projection)
  (task-statuses :vector<task-status>)
  (flashcards :vector<flashcard>)
  (sync-connected :bool)
  (applied-server-t :option<int>)
  (has-pending-semantic-operations :bool)
  (has-pending-sync-request :bool)
  (is-pending-sync-patch :bool)
  (search-query :string)
  (search-results :vector<search-hit>)
  (node-routes :vector<node-projection>)
  (outliner-editing :option<outliner-editing>)
  (outliner-autocomplete :option<outliner-autocomplete>)
  (outliner-autocomplete-candidates
   :vector<outliner-autocomplete-candidate>)
  (outliner-selected-block-ids :vector<string>)
  (outliner-rows :vector<outline-row>)
  (has-older-journals :bool)
  (is-outliner-patch :bool)
  (outliner-row-splices :vector<outline-row-splice>))

(type-variant chat-effect
  (SendCaptureEffect :int :string)
  (SendTaskEffect :int :string :task-status)
  (PersistComposerDraftEffect :int :string)
  (PresentAttachmentEffect :int :string)
  (PresentAssetEffect :int :string :string :string)
  (PresentPageShareEffect :int :string :vector<string>)
  (SetPageFavoriteEffect :int :string :bool)
  (DeletePageEffect :int :string)
  (SyncNowEffect :int)
  (SetOutlinerTaskStatusEffect :int :string :task-status)
  (SearchNodesEffect :int :string)
  (TapOutlinerBlockEffect :int :string)
  (ChangeOutlinerTextEffect :int :string :string :int)
  (ReturnOutlinerEditorEffect :int :string :string :int)
  (BackspaceOutlinerEditorEffect :int :string :string :int)
  (MoveOutlinerCaretEffect :int :string :int)
  (ToggleOutlinerCollapsedEffect :int :string)
  (ZoomOutlinerBlockEffect :int :string)
  (LongPressOutlinerBlockEffect :int :string)
  (DropOutlinerBlocksEffect :int :string :string)
  (OutlinerToolbarEffect :int :string)
  (ChooseOutlinerAutocompleteEffect :int :string)
  (OpenAppNodeEffect :int :string)
  (OpenSearchNodeEffect :int :string)
  (CloseAppNodeEffect :int :string)
  (CloseSearchNodeEffect :int :string)
  (AddRootBlockEffect :int :string)
  (SelectSidebarPageEffect :int :string)
  (ClearSelectedPageEffect :int)
  (LoadOlderJournalsEffect :int)
  (LoadFlashcardsEffect :int)
  (ReviewFlashcardEffect :int :string :string)
  (RefreshGraphsEffect :int)
  (OpenGraphEffect :int :string)
  (UnlockGraphEffect :int :string)
  (CreateGraphEffect :int :string :bool)
  (DeleteLocalGraphEffect :int :string)
  (SaveSettingsEffect :int :settings-projection)
  (ExportGraphDatabaseEffect :int)
  (OpenExternalURLEffect :int :string)
  (RefreshRuntimeLogEffect :int :string :bool :bool)
  (CopyRuntimeLogEffect :int :vector<runtime-log-record>)
  (SignOutEffect :int))

(type-record chat-model
  (selected-graph :option<string>)
  (selected-graph-id :option<string>)
  (graphs :vector<graph>)
  (local-graph-ids :vector<string>)
  (is-graph-encrypted :bool)
  (is-graph-unlocked :bool)
  (graph-loading :bool)
  (graph-password-open :bool)
  (graph-password :string)
  (sync-state :sync-state)
  (applied-server-t :option<int>)
  (has-pending-semantic-operations :bool)
  (has-pending-sync-request :bool)
  (sync-details-open :bool)
  (destination :primary-destination)
  (sidebar-open :bool)
  (favorites :vector<sidebar-page>)
  (recent-pages :vector<sidebar-page>)
  (selected-page :option<sidebar-page>)
  (selected-page-is-tag :bool)
  (selected-page-is-property :bool)
  (related-rows :vector<outline-row>)
  (linked-reference-rows :vector<outline-row>)
  (task-statuses :vector<task-status>)
  (selected-task-status :option<task-status>)
  (flashcards :vector<flashcard>)
  (flashcard-cloze-revealed :bool)
  (flashcard-answer-revealed :bool)
  (create-graph-open :bool)
  (new-graph-name :string)
  (new-graph-encrypted :bool)
  (pending-graph-deletion :option<graph>)
  (pending-page-deletion :option<sidebar-page>)
  (connection-menu-open :bool)
  (settings-open :bool)
  (settings-tabs-open :bool)
  (runtime-log-open :bool)
  (appearance :string)
  (language :string)
  (language-choices :vector<settings-language-choice>)
  (settings-language-menu-open :bool)
  (community-links :vector<settings-community-link>)
  (spell-check :bool)
  (auto-correction :bool)
  (sidebar-tabs :vector<string>)
  (base-url :string)
  (version :string)
  (revision :string)
  (runtime-log-source :string)
  (runtime-log-errors-only :bool)
  (runtime-log-newest-first :bool)
  (runtime-log-records :vector<runtime-log-record>)
  (search-open :bool)
  (search-query :string)
  (search-results :vector<search-hit>)
  (search-loading :bool)
  (node-routes :vector<node-projection>)
  (outliner-rows :vector<outline-row>)
  (outliner-selected-block-ids :vector<string>)
  (outliner-editing :option<outliner-editing>)
  (outliner-autocomplete :option<outliner-autocomplete>)
  (outliner-autocomplete-candidates :vector<outliner-autocomplete-candidate>)
  (outliner-task-status-block-id :option<string>)
  (outliner-section-markers :vector<journal-section-marker>)
  (has-older-journals :bool)
  (composer-expanded :bool)
  (composer-draft :string)
  (composer-autofocus :bool)
  (pending-effects :vector<chat-effect>)
  (in-flight-effects :vector<chat-effect>)
  (next-effect-id :int)
  (effect-error :option<string>)
  (last-core-response :option<string>)
  (attachment-picker-open :bool)
  (task-status-picker-open :bool)
  (app-navigation-path :vector<navigation-route>)
  (search-navigation-path :vector<navigation-route>))

(type-variant chat-action
  (SelectGraph :string)
  (BeginSync)
  (SyncSucceeded)
  (SyncFailed :string)
  (OpenSearch)
  (ChangeSearchQuery :string)
  (ApplySearchResults :string :vector<search-hit>)
  (ApplyCoreSnapshot :core-projection)
  (BeginOutlinerEdit :string)
  (ChangeOutlinerText :string :string :int)
  (ReturnOutlinerEditor :string :string :int)
  (BackspaceOutlinerEditor :string :string :int)
  (MoveOutlinerCaret :string :int)
  (ToggleOutlinerCollapsed :string)
  (ZoomOutlinerBlock :string)
  (LongPressOutlinerBlock :string)
  (BeginOutlinerDrag :string)
  (DropOutlinerBlocks :string :string)
  (PerformOutlinerToolbarAction :string)
  (ChooseOutlinerAutocomplete :string)
  (OpenOutlinerAsset :string)
  (CloseSearch)
  (ExpandComposer)
  (FocusComposer)
  (ApplyComposerDraft :string)
  (ChangeComposerDraft :string)
  (DismissComposer)
  (SendComposer)
  (DequeueEffect :int)
  (ResolveEffect :int :bool :string)
  (OpenAttachmentPicker)
  (CloseAttachmentPicker)
  (ChooseAttachment :string)
  (OpenTaskStatusPicker)
  (CloseTaskStatusPicker)
  (ChooseTaskStatus :string)
  (ClearTaskStatus)
  (RequestAppNode :string)
  (ResolveAppNode :string :bool)
  (BackAppNavigation)
  (RequestSearchNode :string)
  (ResolveSearchNode :string :bool)
  (BackSearchNavigation)
  (AddRootBlock :string)
  (LoadOlderJournals)
  (OpenSidebar)
  (CloseSidebar)
  (SelectSidebarPage :string)
  (ShowJournals)
  (ShowFlashcards)
  (ShowGraphs)
  (ApplyLocalGraphIds :vector<string>)
  (ApplyGraphLoading :bool)
  (RefreshGraphs)
  (RequestOpenGraph :string)
  (ChangeGraphPassword :string)
  (SubmitGraphPassword)
  (CancelGraphUnlock)
  (OpenCreateGraph)
  (DismissCreateGraph)
  (ChangeNewGraphName :string)
  (ToggleNewGraphEncrypted :bool)
  (SubmitCreateGraph)
  (RequestDeleteGraph :string)
  (CancelDeleteGraph)
  (ConfirmDeleteGraph)
  (ApplySettingsSnapshot :settings-projection)
  (OpenConnectionMenu)
  (CloseConnectionMenu)
  (ToggleActivePageFavorite)
  (ShareActivePage)
  (RequestDeleteActivePage)
  (CancelDeleteActivePage)
  (ConfirmDeleteActivePage)
  (OpenSyncDetails)
  (CloseSyncDetails)
  (SyncNow)
  (OpenOutlinerTaskStatusPicker :string)
  (CloseOutlinerTaskStatusPicker)
  (ChooseOutlinerTaskStatus :string)
  (OpenSettings)
  (DismissSettings)
  (OpenSettingsTabs)
  (BackSettings)
  (ChangeAppearance :string)
  (OpenSettingsLanguageMenu)
  (CloseSettingsLanguageMenu)
  (ChooseSettingsLanguage :string)
  (ToggleSpellCheck :bool)
  (ToggleAutoCorrection :bool)
  (ToggleSidebarTab :string)
  (MoveSidebarTab :string :int)
  (ChangeBaseURL :string)
  (ApplySettings)
  (ExportGraphDatabase)
  (OpenExternalURL :string)
  (OpenRuntimeLog)
  (DismissRuntimeLog)
  (ToggleRuntimeLogErrors)
  (ToggleRuntimeLogOrder)
  (ToggleRuntimeLogSource)
  (ApplyRuntimeLog :vector<runtime-log-record>)
  (RefreshRuntimeLog)
  (CopyRuntimeLog)
  (SignOut)
  (RevealFlashcardCloze)
  (RevealFlashcardAnswer)
  (ReviewFlashcard :string))

(signature logseq-chat.model/task-status
 :fn<string;string;string;string;task-status>)
(signature logseq-chat.model/built-in-task-statuses
 :fn<vector<task-status>>)
(signature logseq-chat.model/settings-language-choices
 :fn<vector<settings-language-choice>>)
(signature logseq-chat.model/settings-community-links
 :fn<vector<settings-community-link>>)
(signature logseq-chat.model/settings-language-by-id
 :fn<vector<settings-language-choice>;string;option<settings-language-choice>>)
(signature logseq-chat.model/initial :fn<chat-model>)
(signature logseq-chat.model/journal-section-key
 :fn<outline-row;option<string>>)
(signature logseq-chat.model/journal-section-title
 :fn<outline-row;string>)
(signature logseq-chat.model/journal-section-markers
 :fn<vector<outline-row>;vector<journal-section-marker>>)
(signature logseq-chat.model/request-route
 :fn<vector<navigation-route>;navigation-route;vector<navigation-route>>)
(signature logseq-chat.model/resolve-route
 :fn<vector<navigation-route>;navigation-route;bool;vector<navigation-route>>)
(signature logseq-chat.model/pop-route
 :fn<vector<navigation-route>;vector<navigation-route>>)
(signature logseq-chat.model/navigation-route-uuid
 :fn<navigation-route;string>)
(signature logseq-chat.model/effect-id :fn<chat-effect;int>)
(signature logseq-chat.model/effect-with-id
 :fn<vector<chat-effect>;int;option<chat-effect>>)
(signature logseq-chat.model/first-flashcard-id
 :fn<vector<flashcard>;option<string>>)
(signature logseq-chat.model/graph-by-id
 :fn<vector<graph>;string;option<graph>>)
(signature logseq-chat.model/task-status-by-id
 :fn<vector<task-status>;string;option<task-status>>)
(signature logseq-chat.model/task-status-identity :fn<task-status;string>)
(signature logseq-chat.model/contains-task-status-identity?
 :fn<vector<task-status>;string;bool>)
(signature logseq-chat.model/available-task-statuses
 :fn<vector<task-status>;vector<task-status>>)
(signature logseq-chat.model/string-vector-contains?
 :fn<vector<string>;string;bool>)
(signature logseq-chat.model/graph-local? :fn<chat-model;string;bool>)
(signature logseq-chat.model/remove-string
 :fn<vector<string>;string;vector<string>>)
(signature logseq-chat.model/required-sidebar-tab? :fn<string;bool>)
(signature logseq-chat.model/toggle-sidebar-tab
 :fn<vector<string>;string;vector<string>>)
(signature logseq-chat.model/move-sidebar-tab
 :fn<vector<string>;string;int;vector<string>>)
(signature logseq-chat.model/bounded-url-delimiter :fn<int;int;int>)
(signature logseq-chat.model/valid-base-url? :fn<string;bool>)
(signature logseq-chat.model/valid-attachment-kind? :fn<string;bool>)
(signature logseq-chat.model/current-settings
 :fn<chat-model;settings-projection>)
(signature logseq-chat.model/active-page
 :fn<chat-model;option<sidebar-page>>)
(signature logseq-chat.model/page-is-favorite?
 :fn<chat-model;string;bool>)
(signature logseq-chat.model/page-share-text
 :fn<sidebar-page;vector<outline-row>;string>)
(signature logseq-chat.model/page-share-asset-paths
 :fn<vector<outline-row>;vector<string>>)
(signature logseq-chat.model/rollback-navigation-effect
 :fn<chat-model;chat-effect;chat-model>)
(signature logseq-chat.model/resolve-successful-effect
 :fn<chat-model;chat-effect;string;chat-model>)
(signature logseq-chat.model/enqueue-close-search-effects
 :fn<chat-model;vector<navigation-route>;chat-model>)
(signature logseq-chat.model/enqueue-effect
 :fn<chat-model;chat-effect;chat-model>)
(signature logseq-chat.model/persist-settings-change
 :fn<chat-model;chat-model;chat-model>)
(signature logseq-chat.model/update-editing
 :fn<chat-model;string;string;int;chat-model>)
(signature logseq-chat.model/row-index
 :fn<vector<outline-row>;string;option<int>>)
(signature logseq-chat.model/contains-row?
 :fn<vector<outline-row>;string;bool>)
(signature logseq-chat.model/splice-start
 :fn<vector<outline-row>;outline-row-splice;option<int>>)
(signature logseq-chat.model/apply-row-splice
 :fn<vector<outline-row>;outline-row-splice;vector<outline-row>>)
(signature logseq-chat.model/apply-row-splices
 :fn<vector<outline-row>;vector<outline-row-splice>;vector<outline-row>>)
(signature logseq-chat.model/merge-row-replacements
 :fn<vector<outline-row>;vector<outline-row>;vector<outline-row>>)
(signature logseq-chat.model/remove-effect
 :fn<vector<chat-effect>;int;vector<chat-effect>>)
(signature logseq-chat.model/remove-search-effects
 :fn<vector<chat-effect>;vector<chat-effect>>)
(signature logseq-chat.model/remove-composer-draft-effects
 :fn<vector<chat-effect>;vector<chat-effect>>)
(signature logseq-chat.model/update :fn<chat-model;chat-action;chat-model>)
