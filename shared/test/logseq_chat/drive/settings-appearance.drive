# Create a local graph, open Settings, and switch the appearance theme
# through the settings menu — ChangeAppearance applies optimistically and
# the save effect is resolved by the host stub.
expect prop:accessibility-identifier=button.graph-add
press prop:accessibility-identifier=button.graph-add
type prop:accessibility-identifier=field.graph-name "Drive Graph"
press prop:accessibility-identifier=button.graph-add.confirm
wait prop:accessibility-identifier=application.shell
press kind:menu-item&text:"Settings"
wait prop:accessibility-identifier=sheet.settings
expect prop:accessibility-identifier=picker.settings.appearance
change prop:accessibility-identifier=picker.settings.appearance.option.dark
expect-prop prop:accessibility-identifier=picker.settings.appearance.option.dark checked true
expect-prop prop:accessibility-identifier=picker.settings.appearance.option.light checked false
change prop:accessibility-identifier=picker.settings.appearance.option.light
expect-prop prop:accessibility-identifier=picker.settings.appearance.option.light checked true
