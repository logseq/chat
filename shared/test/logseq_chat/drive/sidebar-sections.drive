# The sidebar renders the destinations, graph switcher, favorites and
# recent sections.
expect prop:accessibility-identifier=button.graph-add
press prop:accessibility-identifier=button.graph-add
type prop:accessibility-identifier=field.graph-name "Drive Graph"
press prop:accessibility-identifier=button.graph-add.confirm
wait prop:accessibility-identifier=application.shell
expect prop:accessibility-identifier=link.sidebar.journals
expect prop:accessibility-identifier=link.sidebar.flashcards
expect prop:accessibility-identifier=link.sidebar.graphs
expect prop:accessibility-identifier=button.graph-switch
expect prop:accessibility-identifier=section.sidebar.favorites
expect prop:accessibility-identifier=section.sidebar.recent
