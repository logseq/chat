# Settings sheet exposes all sections: general, sync server, editor,
# advanced (export/logs), account (sign out), and about.
expect prop:accessibility-identifier=button.graph-add
press prop:accessibility-identifier=button.graph-add
type prop:accessibility-identifier=field.graph-name "Drive Graph"
press prop:accessibility-identifier=button.graph-add.confirm
wait prop:accessibility-identifier=application.shell
press kind:menu-item&text:"Settings"
wait prop:accessibility-identifier=sheet.settings
expect prop:accessibility-identifier=label.settings.general
expect prop:accessibility-identifier=picker.settings.appearance
expect prop:accessibility-identifier=picker.settings.language
expect prop:accessibility-identifier=label.settings.sync-server
expect prop:accessibility-identifier=field.base-url
expect prop:accessibility-identifier=switch.settings.spell-check
expect prop:accessibility-identifier=switch.settings.auto-correction
expect prop:accessibility-identifier=label.settings.advanced
expect prop:accessibility-identifier=button.export-graph-database
expect prop:accessibility-identifier=button.runtime-log
expect prop:accessibility-identifier=label.settings.account
expect prop:accessibility-identifier=button.sign-out
expect prop:accessibility-identifier=label.settings.about
