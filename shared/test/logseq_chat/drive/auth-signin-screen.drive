# Signed-out mount: the authentication screen renders the logo/title/tagline
# and the hosted sign-in button; pressing it resolves SignInEffect and lands
# on the graph picker.
expect prop:accessibility-identifier=screen.authentication
expect prop:accessibility-identifier=button.hosted-sign-in
expect-absent prop:accessibility-identifier=button.graph-add
expect-absent prop:accessibility-identifier=text.authentication-error
press prop:accessibility-identifier=button.hosted-sign-in
wait prop:accessibility-identifier=button.graph-add
expect-absent prop:accessibility-identifier=screen.authentication
