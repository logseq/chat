# Switching to the Flashcards destination loads cards via
# LoadFlashcardsEffect; revealing cloze then answer shows the ratings.
expect prop:accessibility-identifier=button.graph-add
press prop:accessibility-identifier=button.graph-add
type prop:accessibility-identifier=field.graph-name "Drive Graph"
press prop:accessibility-identifier=button.graph-add.confirm
wait prop:accessibility-identifier=application.shell
press prop:accessibility-identifier=link.sidebar.flashcards
wait prop:accessibility-identifier=screen.flashcards
wait prop:accessibility-identifier=card.flashcard.question
wait prop:accessibility-identifier=button.flashcard.show-cloze
press prop:accessibility-identifier=button.flashcard.show-cloze
wait prop:accessibility-identifier=button.flashcard.show-answer
press prop:accessibility-identifier=button.flashcard.show-answer
wait prop:accessibility-identifier=button.flashcard.rating.good
expect prop:accessibility-identifier=button.flashcard.rating.easy
expect prop:accessibility-identifier=button.flashcard.rating.again
press prop:accessibility-identifier=button.flashcard.rating.good
