; Generated test chunk modules live in an unwrapped library: dune only emits
; compile rules for generated modules listed on a library, not on an
; executable. Their initializers register the tests before the executable's
; own module runs the suite.
(library
 (name logseq_chat_lui_test_parts)
 (modes native)
 (wrapped false)
 (modules
  logseq_chat_lui_test_p1
  logseq_chat_lui_test_p2
  logseq_chat_lui_test_p3
  logseq_chat_lui_test_p4
  logseq_chat_lui_test_p5
  logseq_chat_lui_test_p6
  logseq_chat_lui_test_p7
  logseq_chat_lui_test_p8)
 (flags (:standard -w -27-32-37-39-69))
 (ocamlopt_flags (:standard -Oclassic -inline 0 -linscan))
 (instrumentation
  (backend bisect_ppx))
 (libraries
  logseq_chat_lui_test_base
  logseq_chat_core
  sqlite3
  threads.posix
  datascript-ocaml-native.sqlite
  datascript-ocaml-native
  datascript-ocaml-lg
  lg.edn-backend.native
  lg.runtime
  lg.rrbvec
  lg-test.runtime
  lg-test.alcotest
  melange-edn-native
  melange-transit-core
