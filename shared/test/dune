; See the lg-native-cmi-deps alias in ../native/dune: force the vendored
; duniverse libraries' compiled interfaces to exist before lg runs, so its
; typecheck does not fall back to same-named opam cmis.
(alias
 (name lg-native-cmi-deps)
 (deps
  ../../duniverse/mldoc/lib/.mldoc.objs/byte/mldoc.cmi
  ../../duniverse/angstrom/lib/.angstrom.objs/byte/angstrom.cmi
  ../../duniverse/lg/runtime/.lg_runtime.objs/byte/lg_runtime.cmi
  ../../duniverse/lg/runtime_edn_backend_native/.lg_edn_backend_native.objs/byte/lg_edn_backend.cmi
  ../../duniverse/lg/vendor/rrbvec/.rrbvec.objs/byte/rrbvec.cmi
  ../../duniverse/yojson/lib/.yojson.objs/byte/yojson__T.cmi
  ../../duniverse/datascript-ocaml/type/.datascript_types.objs/byte/datascript_types.cmi
  ../../duniverse/datascript-ocaml/impl/.datascript.objs/byte/datascript.cmi
  ../../duniverse/datascript-ocaml/lg/.datascript_lg.objs/byte/datascript_lg.cmi
  ../../duniverse/persistent-sorted-set-ocaml/lib/.persistent_sorted_set.objs/byte/persistent_sorted_set.cmi
  ../../duniverse/melange-edn/lib_native/.melange_edn_native.objs/byte/melange_edn_native.cmi
  ../../duniverse/melange-transit/lib/common/.transit_core.objs/byte/transit_core.cmi
  ../../duniverse/melange-transit/lib/native/.transit_native.objs/byte/transit_native.cmi
  ../../duniverse/ocaml-fsrs/src/.fsrs.objs/byte/fsrs.cmi
  ../../duniverse/timere/timedesc/.timedesc.objs/byte/timedesc.cmi
  ../../duniverse/timere/timedesc-tzdb/.timedesc_tzdb.objs/byte/timedesc_tzdb.cmi
  ../../duniverse/timere/timedesc-tzlocal/.timedesc_tzlocal.objs/byte/timedesc_tzlocal.cmi
  ../../duniverse/sqlite3-ocaml/lib/.sqlite3.objs/byte/sqlite3.cmi
  ../../duniverse/datascript-ocaml/sqlite/.datascript_sqlite.objs/byte/datascript_sqlite_codec.cmi
  ../native/.logseq_chat_graph_support.objs/byte/logseq_chat_lg_graph_support_native.cmi
  ../native/.logseq_chat_core.objs/byte/logseq_chat_lg_core_native.cmi))

; The app code plus the lg-test framework compile as a chunk off the core
; library's saved state and emit an `include` of Logseq_chat_lg_core_native;
; each test namespace group then compiles as an independent chunk against the
; saved base state, so ocamlopt runs the groups in parallel instead of
; compiling one giant module.
(rule
 (targets logseq_chat_lui_test_base.ml logseq_chat_lui_test_base.state)
 (deps
  ../native/logseq_chat_lg_core_native.state
  ../native/.logseq_chat_core.objs/byte/logseq_chat_lg_core_native.cmi
  %{lib:lg:stdlib/lg/literal.cljc}
  (source_tree ../src/logseq_chat)
  (source_tree ../../duniverse/lui/lg/lui)
  %{lib:lg-test.sources:test.cljc}
  %{lib:lg-test.sources:test_native.cljc}
  %{lib:lg-test.runtime:lg_test_runtime.cmi}
  %{lib:lg-test.alcotest:lg_test_alcotest.cmi}
  %{lib:threads.posix:thread.cmi}
  (alias lg-native-cmi-deps)
  lg_native_include_path
  %{bin:lg})
 (action
  (setenv
   LG_OCAML_INCLUDE_PATH_AUTHORITATIVE
   1
   (setenv
    LG_OCAML_INCLUDE_PATH
    "%{env:OPAM_SWITCH_PREFIX=}/lib/lg-test/runtime:%{env:OPAM_SWITCH_PREFIX=}/lib/lg-test/alcotest:%{ocaml-config:standard_library}/threads:%{read-lines:lg_native_include_path}"
    (setenv
     OCAMLPATH
     "%{env:OPAM_SWITCH_PREFIX=}/lib/lg-test/runtime:%{env:OPAM_SWITCH_PREFIX=}/lib/lg-test/alcotest:%{ocaml-config:standard_library}/threads:%{read-lines:lg_native_include_path}"
     (run
      %{bin:lg}
      --target
      native
      --compile-files-chunk-from
      ../native/logseq_chat_lg_core_native.state
      --prefix-interface
      ../native/.logseq_chat_core.objs/byte/logseq_chat_lg_core_native.cmi
      --emit-state
      logseq_chat_lui_test_base.state
      %{lib:lg:stdlib/lg/literal.cljc}
      ../../duniverse/lui/lg/lui
      ../../duniverse/lui/lg/lui/backend/retained
      ../../duniverse/lui/lg/lui/backend/apple
      ../../duniverse/lui/lg/lui/backend/flutter
      ../src/logseq_chat/model.mli
      ../src/logseq_chat/model.cljc
      ../src/logseq_chat/view.mli
      ../src/logseq_chat/view.cljc
      ../src/logseq_chat/app.mli
      ../src/logseq_chat/app.cljc
      ../src/logseq_chat/snapshot.cljc
      ../src/logseq_chat/native_bridge.mli
      ../src/logseq_chat/native_bridge.cljc
      ../src/logseq_chat/native_crypto.cljc
      %{lib:lg-test.sources:test.cljc}
      %{lib:lg-test.sources:test_native.cljc}
      -o
      logseq_chat_lui_test_base.ml))))))

