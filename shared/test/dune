  mldoc
  str
  unix))

(executable
 (name logseq_chat_lui_test_z)
 (modes exe)
 (modules logseq_chat_lui_test_z)
 ; Test registration happens in the chunk modules' initializers; nothing in
 ; the entry module references them, so force them into the link.
 (link_flags -linkall)
 (flags (:standard -w -27-32-37-39-69))
 ; The generated test modules contain the application and all test namespaces.
 ; Avoid cross-function inlining on the cold test build, retaining debug info.
 (ocamlopt_flags (:standard -Oclassic -inline 0 -linscan))
 (instrumentation
  (backend bisect_ppx))
 (foreign_stubs
  (language c)
  (names logseq_chat_platform_crypto_test_stubs))
 (libraries
  logseq_chat_lui_test_parts
  logseq_chat_lui_test_base
  logseq_chat_core
  sqlite3
  threads.posix
  datascript-ocaml-native.sqlite
  datascript-ocaml-native
