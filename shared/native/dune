(rule
 (targets logseq_chat_e2e_seed.ml logseq_chat_live_sync.ml)
 (deps
  %{lib:lg:stdlib/lg_stdlib_native.state}
  .logseq_chat_core.objs/byte/logseq_chat_lg_core_native.cmi
  lg_native_include_path
  ../src/logseq_chat/entry/e2e_seed.cljc
  ../src/logseq_chat/entry/live_sync.cljc
  %{bin:lg})
 (action
  (setenv LG_OCAML_INCLUDE_PATH_AUTHORITATIVE 1
   (setenv LG_OCAML_INCLUDE_PATH ".logseq_chat_core.objs/byte:%{read-lines:lg_native_include_path}"
    (setenv OCAMLPATH ".logseq_chat_core.objs/byte:%{read-lines:lg_native_include_path}"
     (progn
      (run %{bin:lg} --target native --compile-files-from %{lib:lg:stdlib/lg_stdlib_native.state}
       ../src/logseq_chat/entry/e2e_seed.cljc -o logseq_chat_e2e_seed.ml)
      (run %{bin:lg} --target native --compile-files-from %{lib:lg:stdlib/lg_stdlib_native.state}
       ../src/logseq_chat/entry/live_sync.cljc -o logseq_chat_live_sync.ml)))))))

