(rule
 (target logseq_chat_lg_graph_support_native.ml)
 (deps
  %{lib:signal-lg.states:signal_native.state}
  (:include lg_native_cmi_deps.sexp)
  lg_native_include_path
  ../src/logseq_chat/core/datascript_value.cljc
  ../src/logseq_chat/core/ref_text.cljc
  %{bin:lg})
(action
  (setenv
   LG_OCAML_INCLUDE_PATH_AUTHORITATIVE
   1
   (setenv
    LG_OCAML_INCLUDE_PATH
    %{read-lines:lg_native_include_path}
    (setenv
     OCAMLPATH
     %{read-lines:lg_native_include_path}
     (run
      %{bin:lg}
      --target native
      --compile-files-from %{lib:signal-lg.states:signal_native.state}
      ../src/logseq_chat/core/datascript_value.cljc
      ../src/logseq_chat/core/ref_text.cljc
      -o %{target}))))))

